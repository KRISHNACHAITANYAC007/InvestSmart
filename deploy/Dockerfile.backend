FROM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /build
COPY pom.xml mvnw ./
COPY .mvn/wrapper/maven-wrapper.properties .mvn/wrapper/
RUN sed -i 's/\r$//' mvnw && chmod +x mvnw
COPY src/main src/main
# Run the full test suite on the release checkout before building this image.
RUN ./mvnw -B -DskipTests package

FROM eclipse-temurin:21-jre-jammy
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 investsmart \
    && useradd --uid 10001 --gid investsmart --no-create-home investsmart
WORKDIR /app
COPY --from=build --chown=10001:10001 /build/target/InvestSmart-0.0.1-SNAPSHOT.jar app.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
