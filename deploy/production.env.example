# Copy to deploy/production.env (git-ignored) and fill privately.
# Do not send credentials in chat. Hosting platforms can store these as secrets instead.
# Java does not automatically load this file; use the hosting environment for deployment.
# All blank fields remain intentionally unusable until supplied privately.
# HOSTING: separate staging/production origins, volumes and secrets; one backend.
SPRING_PROFILES_ACTIVE=prod
# Matches the bundled Compose topology. Standalone hosting must set its own URL.
DB_URL=jdbc:mysql://mysql:3306/investsmart
DB_USERNAME=
DB_PASSWORD=
# Compose only: choose a separate database root password. Never use root as DB_USERNAME.
MYSQL_ROOT_PASSWORD=
# Used only by the deliberate non-web bootstrap after verifying this account.
INVESTSMART_ADMIN_EMAIL=
JWT_SECRET=
SECURITY_ENCRYPTION_KEY=
# MARKET DATA: active authorized Upstox account only; no real broker orders.
# Token presence does not establish display/segment permissions or quota acceptance.
UPSTOX_API_TOKEN=
# Optional V3 learning assistant; use a trusted HTTPS OpenAI-compatible endpoint.
AI_CHAT_URL=
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
# Optional HTTPS RSS/Atom feed from a source you are authorized to use.
NEWS_RSS_URL=
# HTTPS: exact matching origins, no slash/path/wildcard or credentials in URLs.
PUBLIC_URL=
CORS_ORIGINS=
# PRIVATE STAGING ONLY: explicit tester IPs/narrow CIDRs; blank rejects staging startup.
# Production does not use this setting. Never default to an unrestricted network.
STAGING_ALLOWED_CIDRS=
# SMTP: authenticated STARTTLS on587, trusted certificate matching SMTP_HOST.
# Production requires STARTTLS and explicitly verifies server identity.
# Supply the provider-authorized sender/domain and credentials privately.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
PORT=8080
# Frontend build-time variable; run the production frontend build with this value.
VITE_API_URL=/api
# CALENDAR: no environment flag invents or activates settlement dates.
# Fill settlement-calendar.csv.example using reviewed authoritative working-day data;
# calendar-review.example.json is a review worksheet, followed by guarded import.
